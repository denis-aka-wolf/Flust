{
  "name": "flust",
  "displayName": "Flust",
  "description": "Visual exploration and editing for Flutter widgets, powered by Dart AST.",
  "version": "0.0.1",
  "publisher": "flust-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:flust.visualEditor",
    "onCommand:flust.openInFlust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flust.openInFlust",
        "title": "Flust: Open in Flust"
      },
      {
        "command": "flust.showLogs",
        "title": "Flust: Show Logs"
      },
      {
        "command": "flust.clearLogs",
        "title": "Flust: Clear Logs"
      }
    ],
    "customEditors": [
      {
        "viewType": "flust.visualEditor",
        "displayName": "Flust Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.w.dart"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "flust.openInFlust",
          "when": "resourceLangId == dart",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Flust",
      "properties": {
        "flust.dartPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to dart.exe (or dart on macOS/Linux). Use this when VS Code cannot find the Dart SDK automatically."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
